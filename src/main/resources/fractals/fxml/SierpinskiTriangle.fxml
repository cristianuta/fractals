<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Polygon?>
<StackPane
        xmlns:fx="http://javafx.com/fxml"
        stylesheets="@../css/SierpinskiCarpet.css"
        fx:id="root"
        fx:controller="com.fractals.sierpinski.fxml.controller.SierpinskiTriangleFXMLController">

    <Polygon fx:id="triangle" StackPane.alignment="CENTER"/>
    <Label fx:id="platform" text="Platform: " styleClass="platform-label" StackPane.alignment="BOTTOM_CENTER"/>

</StackPane>